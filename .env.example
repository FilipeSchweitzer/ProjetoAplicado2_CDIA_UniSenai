# Copie este arquivo para .env e preencha com suas credenciais reais.
# O .env é ignorado pelo Git (ver .gitignore) e NUNCA deve ser commitado.

# PostgreSQL local (usado por criarBanco/db.py)
DATAMOL_DB_NAME=datamol
DATAMOL_DB_USER=postgres
DATAMOL_DB_PASSWORD=sua_senha
DATAMOL_DB_HOST=localhost
DATAMOL_DB_PORT=5432

# Supabase (se aplicável)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
